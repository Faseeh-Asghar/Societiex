# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local, or leave empty to use in-memory dev DB)
MONGO_URI=mongodb://127.0.0.1:27017/societix

# JWT Secrets (Generate secure random 32+ char keys)
JWT_SECRET=societix_super_secret_jwt_access_token_key_2026_fast_nuces_cfd
JWT_REFRESH_SECRET=societix_super_secret_jwt_refresh_token_key_2026_fast_nuces_cfd
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
